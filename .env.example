FLASK_SECRET_KEY=change-me
DATABASE_URL=sqlite:///data/stock_intel.db
HOST=127.0.0.1
PORT=5000
ALLOWED_HOSTS=127.0.0.1,localhost
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=stock-intel/0.1 by your-username
NEWSAPI_KEY=your-newsapi-key
SEC_EDGAR_COMPANY_NAME=Your Name
SEC_EDGAR_EMAIL=you@example.com
# Optional: override the built-in ARKK holdings CSV URL
ARK_ARKK_CSV_URL=
# Optional and paid: AI commentary in the digest; leave blank to keep the app free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Digest email over SMTP; for Gmail use smtp.gmail.com, port 587 and an app password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
# Optional: sender address; defaults to SMTP_USER
DIGEST_FROM_EMAIL=
DIGEST_TO_EMAIL=to@example.com
# Optional: also write each digest to this file path
DIGEST_SAVE_PATH=
SCHEDULER_ENABLED=true
SCHEDULER_TZ=America/New_York
LOG_LEVEL=INFO
